{
  "name": "production-ai-handbook-paywall",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/generate-demo-pdf.mjs && next dev",
    "build": "node scripts/assert-vercel-preview.mjs && node scripts/generate-demo-pdf.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:analytics-contract": "node scripts/check-analytics-parity.mjs",
    "deploy:preview": "node scripts/deploy-vercel-preview.mjs",
    "staging:vercel-bypass": "node scripts/provision-vercel-staging-bypass.mjs",
    "staging:stripe": "node scripts/provision-stripe-staging.mjs",
    "staging:stripe-webhook": "node scripts/provision-stripe-webhook-staging.mjs",
    "staging:sync-webhook-secret": "node scripts/sync-stripe-webhook-secret.mjs",
    "check": "npm run check:analytics-contract && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@clerk/nextjs": "7.6.5",
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "2.6.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
