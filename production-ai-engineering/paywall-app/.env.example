# The repository defaults to a credential-free mock mode. Never deploy mock mode.
APP_MODE=mock
NEXT_PUBLIC_APP_URL=http://localhost:3000
SELLER_NAME=Surfaces
SUPPORT_EMAIL=hello@surfaces.systems
BASE_DOMAIN=surfaces.systems
LOCAL_AUTH_SECRET=replace-with-at-least-32-random-characters
LOCAL_DEMO_USER_ID=demo-subscriber
LOCAL_DEMO_EMAIL=reader@example.com
LOCAL_DEMO_ENTITLED=true
LOCAL_ENTITLEMENT_FILE=.data/entitlements.json
LOCAL_HANDBOOK_PATH=private/demo-handbook.pdf
MOCK_WEBHOOK_SECRET=replace-with-a-different-32-character-secret
CURRENT_RELEASE_ID=rel_local_demo_20260804

# Approved policy is code-bound as subscriber-access-v1, not environment-tunable:
# canceled access through paid period; one non-resetting 7-day past_due grace;
# completed refund and created chargeback suspend immediately.

# Production mode requires every secret/reference below and fails closed when one
# is absent. The request's allowlisted HTTPS origin is preferred for Stripe return
# URLs; NEXT_PUBLIC_APP_URL and VERCEL_URL are fallbacks for previews.
# APP_MODE=production
# NEXT_PUBLIC_APP_URL=https://staging.surfaces.systems
# VERCEL_URL=is-injected-by-vercel-for-preview-fallback
# SELLER_NAME=Surfaces
# SUPPORT_EMAIL=hello@surfaces.systems
# BASE_DOMAIN=surfaces.systems
# CLERK_SECRET_KEY=sk_...
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
# STAGING_PREVIEW_URL=https://your-protected-preview.vercel.app
# DATABASE_URL=postgresql://...
# BLOB_READ_WRITE_TOKEN=vercel_blob_...
# HANDBOOK_BLOB_URL=https://...private...blob.vercel-storage.com/production-ai-engineering.pdf
# CURRENT_RELEASE_ID=rel_approved_release_id

# Local-only input for the bounded webhook provisioning command. A protected
# preview may include a Vercel automation-bypass query parameter. Never commit it.
# STAGING_STRIPE_WEBHOOK_URL=https://preview.vercel.app/api/webhooks/stripe

# Canonical analytics are enqueued in Neon; no analytics vendor token is consumed
# by this app. Resend configuration belongs to the separately governed subscriber
# operations worker and is intentionally absent here.
