{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfaces.systems/schemas/subscriber-ops/analytics-event.schema.json",
  "title": "Privacy-minimized analytics event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_name", "occurred_at", "actor_ref", "anonymous_ref", "session_ref", "release_id", "source", "properties"],
  "properties": {
    "schema_version": { "const": "1" },
    "event_id": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]{8,}$" },
    "event_name": {
      "enum": [
        "acquisition.teaser_viewed",
        "acquisition.sample_opened",
        "acquisition.sample_downloaded",
        "acquisition.sample_engaged",
        "acquisition.offer_viewed",
        "acquisition.email_opted_in",
        "acquisition.referral_shared",
        "billing.checkout_started",
        "billing.subscription_activated",
        "billing.renewal_paid",
        "billing.payment_failed",
        "subscriber.pdf_access_requested",
        "subscriber.pdf_access_granted",
        "subscriber.pdf_access_denied",
        "subscriber.weekly_delivery_accepted",
        "subscriber.weekly_delivery_bounced",
        "subscriber.field_note_opened",
        "billing.cancellation_requested",
        "billing.subscription_ended",
        "billing.refund_requested",
        "billing.refund_completed",
        "operations.incident_opened",
        "operations.release_withdrawn"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor_ref": { "type": ["string", "null"] },
    "anonymous_ref": { "type": ["string", "null"] },
    "session_ref": { "type": ["string", "null"] },
    "release_id": { "type": ["string", "null"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "campaign", "content", "referrer_host"],
      "properties": {
        "channel": { "enum": ["linkedin", "reddit", "hacker_news", "direct", "referral", "email", "search", "other"] },
        "campaign": { "type": ["string", "null"], "maxLength": 100 },
        "content": { "type": ["string", "null"], "maxLength": 100 },
        "referrer_host": { "type": ["string", "null"], "maxLength": 253 }
      }
    },
    "properties": { "type": "object" }
  }
}
