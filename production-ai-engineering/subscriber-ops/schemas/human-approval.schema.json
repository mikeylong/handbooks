{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfaces.systems/schemas/subscriber-ops/human-approval.schema.json",
  "title": "Bound human approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "scope",
    "environment",
    "release_id",
    "decision",
    "decided_at",
    "expires_at",
    "authorizer",
    "bound_artifacts",
    "allowed_actions",
    "reason"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "approval_id": { "type": "string", "pattern": "^apr_[a-z0-9][a-z0-9_-]{7,95}$" },
    "scope": { "enum": ["EDITORIAL", "PROMOTION", "SEND", "REFUND", "ENTITLEMENT_OVERRIDE", "DEPLOYMENT", "LIVE_BILLING"] },
    "environment": { "enum": ["test", "staging", "production"] },
    "release_id": { "type": ["string", "null"] },
    "decision": { "enum": ["APPROVED", "REJECTED"] },
    "decided_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "authorizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "role", "method"],
      "properties": {
        "actor_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "method": { "enum": ["signed_ui", "cli_attestation", "recorded_manual"] }
      }
    },
    "bound_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/nullableSha256" },
        "audience_sha256": { "$ref": "#/$defs/nullableSha256" },
        "content_sha256": { "$ref": "#/$defs/nullableSha256" },
        "refund_request_sha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "recipient_ceiling": { "type": ["integer", "null"], "minimum": 0 },
    "scheduled_not_before": { "type": ["string", "null"], "format": "date-time" },
    "scheduled_not_after": { "type": ["string", "null"], "format": "date-time" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
  },
  "$defs": {
    "nullableSha256": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      ]
    }
  }
}
