{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfaces.systems/schemas/subscriber-ops/audit-event.schema.json",
  "title": "Append-only audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "aggregate_id",
    "sequence",
    "event_type",
    "occurred_at",
    "actor",
    "idempotency_key",
    "payload",
    "previous_event_sha256",
    "event_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "event_id": { "type": "string", "pattern": "^aevt_[a-z0-9][a-z0-9_-]{7,95}$" },
    "aggregate_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": { "type": "string", "pattern": "^[a-z]+(\\.[a-z0-9_]+)+$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["human", "service", "provider"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" },
    "previous_event_sha256": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      ]
    },
    "event_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
