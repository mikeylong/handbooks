+  "$NODE_BIN" - "$RUN_DIR" "$RESEARCH_OUTPUT_DIR" <<'NODE'
+  'use strict';
+  const fs = require('node:fs');
+  const path = require('node:path');
+  const [runDirectory, researchDirectory] = process.argv.slice(2);
+  const names = ['sources.md', 'sources.json', 'blocked-sources.md', 'change-report.md', 'changes.json', 'coverage.json', 'release-recommendation.json', 'research-agent-summary.md'];
+  const ensure = (condition, message) => { if (!condition) throw new Error(message); };
+  function regularUnredirected(file, directory = false) {
+    for (let cursor = path.resolve(file); ; cursor = path.dirname(cursor)) {
+      const entry = fs.lstatSync(cursor);
+      ensure(!entry.isSymbolicLink(), 'Unsafe redirected research import: ' + cursor);
+      if (cursor === path.dirname(cursor)) break;
+    }
+    const entry = fs.statSync(file);
+    ensure(directory ? entry.isDirectory() : entry.isFile() && entry.size > 0, 'Missing, empty or unsafe research artifact: ' + file);
+  }
+  ensure(path.isAbsolute(runDirectory) && researchDirectory === path.join(runDirectory, 'research-output'), 'Research import requires the exact prepared research-output directory');
+  regularUnredirected(runDirectory, true);
+  regularUnredirected(researchDirectory, true);
+  // Read and validate every source before reserving any destination. O_NOFOLLOW
+  // also refuses a source-file link introduced after its path check.
+  const artifacts = names.map(name => {
+    const source = path.join(researchDirectory, name), destination = path.join(runDirectory, name);
+    regularUnredirected(source);
+    const descriptor = fs.openSync(source, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);
+    let content;
+    try {
+      const entry = fs.fstatSync(descriptor);
+      ensure(entry.isFile() && entry.size > 0, 'Unsafe opened research artifact: ' + source);
+      content = fs.readFileSync(descriptor);
+      ensure(content.length > 0, 'Empty opened research artifact: ' + source);
+      if (name.endsWith('.json')) JSON.parse(content.toString('utf8'));
+    } finally { fs.closeSync(descriptor); }
+    return { destination, content };
+  });
+  for (const { destination } of artifacts) {
+    let entry;
+    try { entry = fs.lstatSync(destination); }
+    catch (error) { if (error.code !== 'ENOENT') throw error; }
+    ensure(!entry, 'Research import destination already exists; preserve it: ' + destination);
+  }
+  const reserved = [];
+  try {
+    // O_EXCL refuses files, directories and even dangling symlinks created after
+    // the prechecks. Reserve all outputs before writing any report content.
+    for (const artifact of artifacts) reserved.push({ ...artifact, descriptor: fs.openSync(artifact.destination, 'wx', 0o600) });
+    for (const artifact of reserved) fs.writeFileSync(artifact.descriptor, artifact.content);
+  } finally {
+    // A failed reservation leaves only its own empty files as failed-run
+    // evidence; never unlink or overwrite a colliding or redirected path.
+    for (const artifact of reserved) fs.closeSync(artifact.descriptor);
+  }
+  process.stdout.write('Imported all required top-level research artifacts.\n');
+NODE
 }
 
