{
  "schemaVersion": 1,
  "designSystemVersion": "1.0.0",
  "profile": "editorial-technical-monochrome",
  "page": {
    "trim": "A5",
    "width": "148mm",
    "height": "210mm",
    "marginTop": "15mm",
    "marginInside": "13mm",
    "marginOutside": "13mm",
    "marginBottom": "18mm"
  },
  "color": {
    "paper": "#ffffff",
    "ink": "#000000",
    "muted": "#333333",
    "line": "#bbbbbb",
    "lineStrong": "#777777",
    "tableHeader": "#f4f4f2"
  },
  "font": {
    "serif": {
      "family": "Source Serif 4",
      "regular": "fonts/source-serif-4-latin-variable.woff2",
      "italic": "fonts/source-serif-4-latin-variable-italic.woff2"
    },
    "sans": {
      "family": "Noto Sans",
      "regular": "fonts/NotoSans-Regular.ttf",
      "bold": "fonts/NotoSans-Bold.ttf"
    },
    "mono": {
      "family": "Source Code Pro",
      "regular": "fonts/SourceCodePro-Regular.ttf",
      "semibold": "fonts/SourceCodePro-Semibold.ttf"
    }
  },
  "type": {
    "body": { "size": "10pt", "lineHeight": 1.5 },
    "coverTitle": { "size": "42pt", "lineHeight": 0.9, "weight": 400 },
    "chapterTitle": { "size": "28pt", "lineHeight": 0.98, "weight": 400 },
    "sectionTitle": { "size": "18pt", "lineHeight": 1.12, "weight": 500 },
    "subsectionTitle": { "size": "14pt", "lineHeight": 1.2, "weight": 500 },
    "label": { "size": "7pt", "lineHeight": 1.3, "weight": 700, "tracking": "0.12em" },
    "table": { "size": "7.2pt", "lineHeight": 1.3, "minimumSize": "6.6pt" },
    "code": { "size": "7.8pt", "lineHeight": 1.55 },
    "runningHead": { "size": "6.2pt", "lineHeight": 1.0 },
    "folio": { "size": "7pt", "lineHeight": 1.0 }
  },
  "space": {
    "paragraphBlock": "0.9em",
    "sectionGap": "9mm",
    "sectionPadding": "7mm",
    "componentBlock": "3mm",
    "tableCell": "1.5mm"
  },
  "rule": {
    "hairline": "0.35pt",
    "standard": "0.6pt",
    "strong": "0.8pt"
  },
  "illustration": {
    "defaultWidth": "104mm",
    "maximumWidth": "116mm",
    "background": "#ffffff",
    "colorMode": "grayscale",
    "minimumEffectivePpi": 240,
    "preferredEffectivePpi": 300,
    "opacity": 1,
    "allowMasks": false,
    "allowFilters": false,
    "allowClipPaths": false
  }
}
